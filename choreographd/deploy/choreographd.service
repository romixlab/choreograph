# choreographd, the choreograph scheduler as a service. Install as /etc/systemd/system/choreographd.service.
#
#   config  /etc/choreographd/config.toml   root:root 0644; no secret in it (clients carry only token hashes)
#   socket  /run/choreographd/api.sock      the API (the default listener), mode 0660 (socket_mode): the
#                                            members of the group `choreograph` may call it (a mesh proxy
#                                            that carries calls from other machines, local tools); the group
#                                            comes from choreographd.sysusers (/etc/sysusers.d/choreographd.conf)
#   state   /var/lib/choreographd           the journal, owned by the unit's dynamic user
#
# With TLS and tokens instead (config.tls.example.toml), uncomment the two LoadCredential= lines:
#   key     /etc/choreographd/key.pem       root:root 0600, handed in as a credential only this unit reads;
#                                            the config names it `key = "key.pem"` (relative paths resolve in
#                                            $CREDENTIALS_DIRECTORY)
#   cert    /etc/choreographd/cert.pem      the certificate chain, also a credential (`cert = "cert.pem"`)
#
# Fails loudly, never in a loop: restarts with a growing pause, ends in `failed` after a run of fast crashes,
# and does not retry at all what only a person can fix (exit 78: a bad configuration, TLS files that cannot be
# used, a journal that is unreadable or written by a newer version, something other than a socket at the
# socket's path; 243: a credential file is not there).
[Unit]
Description=choreographd, the choreograph scheduler as a service
Documentation=https://github.com/romixlab/choreograph
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=6

[Service]
Type=simple
DynamicUser=yes
Group=choreograph
ExecStart=/usr/local/bin/choreographd serve --config /etc/choreographd/config.toml
Environment=RUST_LOG=choreographd=info
ConfigurationDirectory=choreographd
StateDirectory=choreographd
RuntimeDirectory=choreographd
RuntimeDirectoryMode=0750
#LoadCredential=cert.pem:/etc/choreographd/cert.pem
#LoadCredential=key.pem:/etc/choreographd/key.pem

Restart=on-failure
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=5min
RestartPreventExitStatus=78 243

# It needs its socket (or the network) and its state directory, nothing else of the host.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
